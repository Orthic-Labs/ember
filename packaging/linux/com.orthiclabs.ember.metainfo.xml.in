<?xml version="1.0" encoding="UTF-8"?>
<!-- AppStream metadata (software centres, Flathub). Template: package.sh and the Flatpak
     manifest substitute @VERSION@ and @DATE@ from Cargo.toml and the build date. -->
<component type="desktop-application">
  <id>com.orthiclabs.ember</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT OR Apache-2.0</project_license>
  <name>Ember</name>
  <summary>Organise photos and develop raw files, non-destructively</summary>
  <developer id="com.orthiclabs">
    <name>Orthic Labs</name>
  </developer>
  <description>
    <p>
      Ember is a photo library and raw developer. Organise photos and develop raw files, non-destructively
    </p>
  </description>
  <launchable type="desktop-id">com.orthiclabs.ember.desktop</launchable>
  <icon type="stock">com.orthiclabs.ember</icon>
  <!-- Only url types known to appstream 0.15 (Ubuntu 22.04, where CI validates): no vcs-browser. -->
  <url type="homepage">https://github.com/Orthic-Labs/ember</url>
  <url type="bugtracker">https://github.com/Orthic-Labs/ember/issues</url>
  <url type="help">https://github.com/Orthic-Labs/ember</url>
  <url type="contact">https://github.com/Orthic-Labs/ember/issues</url>
  <categories>
    <category>Graphics</category>
    <category>RasterGraphics</category>
    <category>Photography</category>
  </categories>
  <keywords>
    <keyword>photo</keyword>
    <keyword>image editor</keyword>
    <keyword>raw</keyword>
    <keyword>non-destructive</keyword>
  </keywords>
  <branding>
    <color type="primary" scheme_preference="light">#ffad57</color>
    <color type="primary" scheme_preference="dark">#ffad57</color>
  </branding>
  <requires>
    <display_length compare="ge">760</display_length>
  </requires>
  <supports>
    <control>keyboard</control>
    <control>pointing</control>
    <control>tablet</control>
  </supports>
  <provides>
    <binary>lightcraft</binary>
  </provides>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="@VERSION@" date="@DATE@"/>
  </releases>
</component>
