{
  "schemaVersion": 1,
  "compile": "github-actions-only",
  "lanes": [
    "ci",
    "release-candidate"
  ],
  "matrix": {
    "os": [
      "macos-15",
      "windows-2025"
    ],
    "node": [
      "26.8.1"
    ]
  },
  "ciAllOs": true,
  "qaEvidencePath": "ember-native-e2e/qa-evidence",
  "qaEvidenceRetentionDays": 7,
  "ciIncremental": true,
  "devArtifact": {
    "mac": "sign",
    "windows": "unsigned",
    "parallel": true,
    "buildScript": "desktop:artifact:build",
    "macAppPath": "target/aarch64-apple-darwin/debug/bundle/macos/Ember.app",
    "windowsGlob": "target/x86_64-pc-windows-msvc/debug/bundle/nsis/**"
  },
  "packageManager": "pnpm@11.25.0",
  "templateVersion": "1.8.0",
  "profile": "rust-hybrid",
  "ownership": {
    "roots": [
      "."
    ]
  },
  "rustCache": {
    "workspaces": [
      "."
    ],
    "requiredForGate": true
  },
  "gate": {
    "path": "scripts/desktop/gate.sh"
  },
  "candidate": {
    "buildScript": "release:candidate:build",
    "checkScript": "release:candidate:check",
    "admissionScript": "release:admit",
    "stageSummaryScript": "release:stage-summary",
    "artifactRoot": "lightcraft-candidate",
    "os": [
      "macos-15",
      "windows-2025"
    ],
    "targets": [
      {
        "os": "macos-15",
        "platform": "macos",
        "architecture": "arm64"
      },
      {
        "os": "windows-2025",
        "platform": "windows",
        "architecture": "x86_64"
      }
    ],
    "signWindows": true,
    "signMacos": true
  }
}
