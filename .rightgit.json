{
  "schemaVersion": 1,
  "compile": "github-actions-only",
  "lanes": [
    "ci",
    "release-candidate"
  ],
  "matrix": {
    "os": [
      "macos-15",
      "windows-2025"
    ],
    "node": [
      "26.8.1"
    ]
  },
  "ciAllOs": true,
  "packageManager": "pnpm@11.24.0",
  "templateVersion": "1.8.0",
  "profile": "rust-hybrid",
  "ownership": {
    "roots": [
      "."
    ]
  },
  "rustCache": {
    "workspaces": [
      "."
    ],
    "requiredForGate": true
  },
  "gate": {
    "path": "scripts/desktop/gate.sh"
  },
  "candidate": {
    "buildScript": "release:candidate:build",
    "checkScript": "release:candidate:check",
    "admissionScript": "release:admit",
    "stageSummaryScript": "release:stage-summary",
    "artifactRoot": "lightcraft-candidate",
    "os": [
      "macos-15",
      "windows-2025"
    ],
    "targets": [
      {
        "os": "macos-15",
        "platform": "macos",
        "architecture": "arm64"
      },
      {
        "os": "windows-2025",
        "platform": "windows",
        "architecture": "x86_64"
      }
    ],
    "signWindows": false,
    "signMacos": false
  }
}
