        {
          "ruleId": "ai-slop-cli-test-comment-claims-undo",
          "level": "note",
          "message": {
            "text": "Either add an `edit.undo` step asserting the baseline exposure returns, or drop 'undo restores' from the comment.: The comment says the apply step checks that \"the values land, repeat-stable, undo restores\", but the test never runs an undo or asserts restored values; it only compares two applyLook results (the second with dryRun=true) and a finite exposure. A regression in undo of develop.applyLook would pass this test while its comment claims coverage."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
