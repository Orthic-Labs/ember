      "results": [
        {
          "ruleId": "a11y-progress-unnamed",
          "level": "note",
          "message": {
            "text": "Give each <progress> an aria-label or aria-labelledby pointing at the adjacent label span (job label / 'Downloading SAM 3' / 'Verifying SAM 3 model folder').: Progress renders <progress max value /> with no accessible name (no aria-label/aria-labelledby/wrapping label); the visible text label is a sibling <span>, not associated. A screen reader user tabbing or browsing to the import/export/SAM download progress hears only an unnamed progress bar with a percentage and cannot tell which operation it reports."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "apps/lightcraft-desktop/web/src/dialogs/DialogHost.tsx"
                },
                "region": {
                  "startLine": 109
                }
              }
            },
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "apps/lightcraft-desktop/web/src/dialogs/DialogHost.tsx"
                },
                "region": {
                  "startLine": 965,
                  "endLine": 966
                }
              }
            }
          ],
          "partialFingerprints": {
            "legionFinding/v1": "a11y-progress-unnamed"
          },
          "properties": {
            "severity": "low",
            "confidence": "likely",
            "provider": "reasoning.a11y",
            "evidence": {
              "action": "Give each <progress> an aria-label or aria-labelledby pointing at the adjacent label span (job label / 'Downloading SAM 3' / 'Verifying SAM 3 model folder').",
              "confidence": "likely",
              "lens": "a11y",
              "verifyStatus": "unverified"
            }
          }
        },
        {
          "ruleId": "ai-slop-bt2020-pq-constants-repeated",
          "level": "note",
          "message": {
            "text": "Hoist `BT2020_LUMA` and the PQ constants to module-level consts shared by pq_encode/pq_decode and the three encoders.: The BT.2020 luminance weights `[0.2627, 0.6780, 0.0593]` are declared as three separate local consts (hlg_signal, encode_avif_hdr, encode_png_pq), and the ST 2084 constants M1/M2/C1/C2/C3 are declared twice (pq_encode, pq_decode). The sibling BT.601 weights are likewise a fourth local K. A later correction to one copy leaves the HDR AVIF, HLG and PQ PNG paths with different luma weights, producing silently inconsistent HDR output between formats."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "crates/codecs/src/encode.rs"
                },
                "region": {
                  "startLine": 413
                }
              }
            },
