        {
          "ruleId": "p0006-schema-catalog-download-url-filename-contract",
          "level": "warning",
          "message": {
            "text": "Download catalog entries from their exact url with lightcraft_fetch::download_url (which keeps the query and takes the local name from FileSpec), or reject at catalog parse time any url whose path does not end in `/<file_name>` with no query.: Download.base() assumes the url ends in `/<file_name>`, an invariant enforced only by the built-in table's test (known.rs:199). User catalog entries break it: catalog::entry accepts any https url and derives file_name by stripping the query and filtering characters, and face_download passes spec.base() to lightcraft_fetch::download, which requests `<base>/<file_name>`. For the module's own documented shape `https://example.org/w/recogniser-r50.onnx?download=1` (catalog.rs test), strip_suffix fails, base() returns the whole url and the request becomes `.../recogniser-r50.onnx?download=1/recogniser-r50.onnx`. A url without an .onnx name (`https://host/files/123`) gets file_name `model.onnx` and fetches `https://host/files/123/model.onnx`. Signed or query-bearing catalog urls therefore cannot be downloaded, though the catalog accepts them."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "crates/faces/src/catalog.rs"
                },
                "region": {
                  "startLine": 75,
