      "findingEvidence": {
        "p0006-security-tls-truncation-accepted-as-eof": {
          "lens": "security",
          "confidence": "likely",
          "verifyStatus": "verified",
          "action": "In BodyMode::Close over TLS, treat UnexpectedEof or a read_tls of 0 without close_notify as HttpError::Protocol (truncated), or require Content-Length or chunked for unpinned files; pinning sizes and hashes for vocab.json and merges.txt also closes it."
        }
      },
      "findingLocations": {
        "p0006-security-tls-truncation-accepted-as-eof": [
          "crates/fetch/src/http.rs:300-310",
          "crates/fetch/src/http.rs:438-444",
          "crates/fetch/src/http.rs:547-549",
          "crates/fetch/src/lib.rs:477-511"
        ]
      },
      "findingMessages": {
        "p0006-security-tls-truncation-accepted-as-eof": "For https, a TCP close without TLS close_notify (rustls UnexpectedEof), and a raw read_tls of 0, are both returned as a clean end of stream. Length and Chunked bodies catch this, but a response with neither Content-Length nor chunked encoding uses BodyMode::Close, where the 0 marks the body as Done. A network attacker who injects a FIN/RST can then truncate the body undetected. fetch_file keeps unpinned files (size None, sha256 None) once len > 0, and segment/src/fetch/mod.rs:20-21 downloads vocab.json and merges.txt exactly that way, so a truncated merges.txt is installed as complete and silently degrades the tokenizer."
      },
      "findingTitles": {
        "p0006-security-tls-truncation-accepted-as-eof": "In BodyMode::Close over TLS, treat UnexpectedEof or a read_tls of 0 without close_notify as HttpError::Protocol (truncated), or require Content-Length or chunked for unpinned files; pinning sizes and hashes for vocab.json and merges.txt also closes it."
      },
