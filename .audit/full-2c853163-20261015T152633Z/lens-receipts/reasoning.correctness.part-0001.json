      "findingLocations": {
        "correctness-decision-manifest-source-family-id-splits-virtual-copies": [
          "apps/lightcraft-cli/src/decision_manifest.rs:109-114",
          "apps/lightcraft-cli/src/decision_manifest.rs:154",
          "apps/lightcraft-cli/src/decision_manifest.rs:474-485"
        ]
      },
      "findingMessages": {
        "correctness-decision-manifest-source-family-id-splits-virtual-copies": "source_family_id is computed with virtual_identity(), which returns \"original:<uuid>\" for a master photo (masterImage 0) but \"master:<master uuid>\" for each of its virtual copies. A master and its virtual copies therefore get different source_family_id values. The manifest's own split_policy says any later split must keep source_family_id groups intact, so a consumer that groups by this field can put the master in train and a virtual copy of the same image in test, leaking the same source pixels across splits. The field is also a byte-for-byte duplicate of virtual_copy_identity, so it adds no family grouping at all."
      },
      "findingTitles": {
        "correctness-decision-manifest-source-family-id-splits-virtual-copies": "Derive source_family_id from the family root, e.g. the master's uuid for both the master and its copies (\"family:<root uuid>\"), and keep virtual_copy_identity as the per-copy identity. Add a test with one master plus one virtual copy that asserts both rows share source_family_id."
      },
