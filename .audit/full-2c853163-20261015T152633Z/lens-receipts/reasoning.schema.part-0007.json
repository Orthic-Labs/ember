      "findingLocations": {
        "schema-xmp-dc-creator-seq-collapsed": [
          "crates/meta/src/xmp.rs:521-523",
          "crates/meta/src/xmp.rs:657"
        ]
      },
      "findingMessages": {
        "schema-xmp-dc-creator-seq-collapsed": "dc:creator is an ordered rdf:Seq of creators. parse_xmp joins every entry into one string (\"Alice; Bob\") and write_xmp_lc writes Metadata.artist back as a single rdf:li. Because Ember's sidecar merge owns dc:creator (always replaced on save), a sidecar from another app with creators [Alice, Bob] is rewritten on Ember's next save as one creator \"Alice; Bob\", even when the user never edited the artist. Other readers then see one creator whose name contains a semicolon."
      },
      "findingTitles": {
        "schema-xmp-dc-creator-seq-collapsed": "Keep the creator list structured (e.g. a Vec in Metadata), or split artist on the same \"; \" separator when writing so that read and write are inverses."
      },
