{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ember",
  "version": "0.7.0",
  "identifier": "com.orthiclabs.ember",
  "build": {
    "devUrl": "http://127.0.0.1:18483",
    "frontendDist": "web/dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "visible": false,
        "title": "Ember",
        "width": 1600,
        "height": 1000,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob: data: lightcraft-preview: http://lightcraft-preview.localhost; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost lightcraft-preview: http://lightcraft-preview.localhost; font-src 'self'; script-src 'self'; frame-ancestors 'none'",
      "capabilities": [
        "main"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "app",
      "dmg",
      "nsis"
    ],
    "icon": [
      "../../assets/app-icon/hicolor/256x256/apps/com.orthiclabs.ember.png",
      "../../assets/app-icon/ember.icns",
      "../../assets/app-icon/ember.ico"
    ],
    "resources": {
      "../../NOTICE": "NOTICE",
      "../../LICENSE-MIT": "LICENSE-MIT",
      "../../LICENSE-APACHE": "LICENSE-APACHE",
      "../../docs/licenses/pytorch-bicubic-LICENSE.txt": "docs/licenses/pytorch-bicubic-LICENSE.txt"
    },
    "copyright": "Orthic Labs & contributors",
    "category": "Photography",
    "shortDescription": "Photo library & non-destructive RAW developer",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI5Mzk1RjlGRjQ2NjI2MUQKUldRZEptYjBuMTg1S1VSUXlBdFM4WmtzaHArYko0U2hRMDVlSDJmSExVZG82Q0hoQ2srUlhqanAK",
      "windows": {
        "installMode": "passive"
      },
      "endpoints": [
        "https://github.com/Orthic-Labs/ember/releases/latest/download/latest.json"
      ]
    }
  }
}
